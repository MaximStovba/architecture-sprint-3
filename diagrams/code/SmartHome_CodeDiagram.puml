@startuml 
title Smart Home Code Diagram

top to bottom direction

!include C4_Component.puml

class User {
  +String name
  +String email
  +List<Home> homes
  +void register()
  +void login()
}

class Home {
  +String address
  +List<Device> devices
  +void addDevice(Device device)
  +void removeDevice(Device device)
}

class Device {
  +String deviceId
  +String type
  +String status
  +void turnOn()
  +void turnOff()
  +void updateStatus(String status)
}

User "1" -- "0..*" Home : owns
Home "1" -- "0..*" Device : contains

@enduml
